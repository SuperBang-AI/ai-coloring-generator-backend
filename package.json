{
  "name": "coloring-generator-backend",
  "version": "1.0.0",
  "description": "AI Coloring Page Generator - Cloudflare Workers Backend",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 execute coloring-gen-db --local --file=migrations/0001_init.sql",
    "migrate:remote": "wrangler d1 execute coloring-gen-db --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260430.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.50.0"
  }
}
